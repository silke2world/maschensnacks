:root {
  --bg: #f3efe8;
  --paper: #faf8f4;
  --green: #65745b;
  --dark: #414b3d;
  --text: #454740;
  --line: #d7d0c4;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, sans-serif;
  line-height: 1.7;
}

header, main, footer {
  max-width: 900px;
  margin: auto;
  padding: 24px;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--line);
  font-size: 0.85rem;
  letter-spacing: 0.06em;
}

header a {
  color: var(--green);
  text-decoration: none;
}

main {
  background: var(--paper);
  margin-top: 24px;
  margin-bottom: 24px;
  padding: clamp(24px, 5vw, 55px);
  border-radius: 12px;
}

h1, h2, h3 {
  color: var(--dark);
  font-weight: 500;
  line-height: 1.3;
}

h1 {
  font-size: clamp(2rem, 5vw, 2.8rem);
  margin-top: 0;
  margin-bottom: 12px;
}

h2 {
  font-size: 1.65rem;
  margin-top: 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
}

h3 {
  font-size: 1.15rem;
  margin-bottom: 4px;
}

a { color: var(--green); }

a:hover { color: var(--dark); }

.meta {
  color: #77786f;
  font-size: 0.85rem;
}

.intro {
  font-size: 1.08rem;
  margin: 30px 0;
}

.toc {
  background: #eeece4;
  padding: 22px 28px;
  border-radius: 8px;
  margin: 35px 0;
}

.toc strong {
  color: var(--dark);
}

.toc ul {
  padding-left: 20px;
  margin-bottom: 0;
}

.toc a {
  text-decoration: none;
}

.entry {
  margin: 22px 0;
}

.entry p {
  margin: 4px 0;
}

.entry-title {
  font-weight: 650;
}

.back {
  display: inline-block;
  margin-top: 35px;
  text-decoration: none;
  font-size: 0.9rem;
}

footer {
  text-align: center;
  color: var(--green);
  font-size: 0.85rem;
  margin-top: 30px;
}

@media (max-width: 550px) {
  header { font-size: 0.75rem; }
  main { margin: 12px; padding: 22px; }
}
